# dependencies
node_modules/
.pnp
.pnp.*

# next
/.next/
/.next-e2e/
/out/
next-env.d.ts

# production
/build
/dist

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# env — the .example files ARE committed, the real ones are not.
#
# `.env.prod` is called out explicitly: the earlier patterns did not match it,
# and it holds the production database password, the S3 secret and AUTH_SECRET.
# A deploy file that silently falls outside the ignore rules is exactly the
# shape of accident that puts credentials in a public repository.
.env
.env.local
.env.*.local
.env.prod
.env.production
!.env.example
!.env.prod.example

# misc
.DS_Store
*.pem
*.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# prisma
prisma/*.db
prisma/*.db-journal

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# Generated build artefact, not source.
bundle-report.json

# Throwaway scripts used while driving the browser during development.
# They have been committed by accident once; this makes that impossible.
tmp-*
/scripts/tmp-*

# Local TLS for testing on a phone. The private key must never be committed.
/certs/

# Generated by the build; the worker reads it at install.
public/precache.json
