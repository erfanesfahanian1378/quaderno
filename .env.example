# =============================================================================
# Quaderno — environment
#
# Copy to .env and fill in. Every variable the app reads is listed here; a
# missing one fails fast at boot rather than at the first request (see
# src/server/env.ts).
# =============================================================================

# --- Core --------------------------------------------------------------------

# Public origin of the app. Used for absolute links in emails and for auth
# callbacks. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# development | test | production. Next sets this itself; only override in
# tooling.
# NODE_ENV="development"

# --- Database ----------------------------------------------------------------

# Host port the compose `db` service publishes on. Change this if you already
# run Postgres locally — on macOS a native listener on 5432 wins for
# connections from the host even though Docker also binds the port, and you
# get a confusing `P1010: User was denied access` from Prisma. Remember to
# change the port in DATABASE_URL and QUEUE_DATABASE_URL to match.
DB_PORT="5432"
MINIO_PORT="9000"
MINIO_CONSOLE_PORT="9001"

# Postgres 16. The `db` service in docker-compose under the `dev` profile.
# The connection limit is capped at 8 on purpose — ARCHITECTURE.md §6 budgets
# the pool, and pgbouncer is not needed at this size.
DATABASE_URL="postgresql://quaderno:quaderno@localhost:5432/quaderno?schema=public&connection_limit=8"

# pg-boss runs on the SAME Postgres, in its own schema. No Redis anywhere in
# this system — that is a deliberate ~150 MB RSS saving.
QUEUE_DATABASE_URL="postgresql://quaderno:quaderno@localhost:5432/quaderno?schema=pgboss"

# --- Auth --------------------------------------------------------------------

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional Google provider (PHASE-02). Leave both blank to disable it.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Object storage (S3-compatible) ------------------------------------------
#
# MinIO locally, Cloudflare R2 or Backblaze B2 in production. Blobs never live
# in Postgres and never pass through the Node process — uploads are presigned
# and reads are 5-minute signed URLs.

S3_ENDPOINT="http://localhost:9000"

# The endpoint the BROWSER is handed in a presigned URL. Leave blank when it is
# the same as S3_ENDPOINT.
#
# Set it when the server and the browser reach storage at different addresses:
#   - testing on a phone on the same wifi -> your machine's LAN IP
#   - Docker -> the server uses http://minio:9000, the browser needs the
#     published host
#
# Getting this wrong is a SILENT failure: the browser PUTs to an address it
# cannot reach, and the document sits at PENDING for ever with no error.
S3_PUBLIC_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="quaderno"
S3_ACCESS_KEY_ID="quaderno"
S3_SECRET_ACCESS_KEY="quaderno-dev-secret"
# MinIO needs path-style addressing; R2/B2 do not.
S3_FORCE_PATH_STYLE="true"

# Origin the browser uses to reach uploaded files. MUST be a different origin
# from the app in production (ARCHITECTURE.md §7) so a malicious SVG or HTML
# upload cannot execute in the app's origin.
NEXT_PUBLIC_STORAGE_ORIGIN="http://localhost:9000"

# --- Mail (PHASE-02) ---------------------------------------------------------

# console | smtp. `console` prints the message to stdout, which is what dev
# and CI use.
MAIL_TRANSPORT="console"
MAIL_FROM="Quaderno <no-reply@quaderno.local>"
SMTP_URL=""

# --- Worker ------------------------------------------------------------------

# Conversion concurrency is 1 and is not a tuning knob: LibreOffice bursts to
# ~350 MB and the box has 2 GB (ARCHITECTURE.md §3, §6).
WORKER_CONVERT_CONCURRENCY="1"
# Hard SIGKILL for a conversion subprocess.
WORKER_CONVERT_TIMEOUT_MS="120000"
# A live timer with no heartbeat for this long is closed by the reaper at its
# last heartbeat (DATA_MODEL.md §7).
STALE_TIMER_MINUTES="20"

# --- Limits ------------------------------------------------------------------

MAX_UPLOAD_BYTES="52428800"          # 50 MB per file
DEFAULT_STORAGE_QUOTA_BYTES="2147483648"  # 2 GiB per user

# --- Observability -----------------------------------------------------------

LOG_LEVEL="debug"                    # trace|debug|info|warn|error|fatal
# Bearer token guarding /api/metrics. Blank disables the endpoint.
METRICS_TOKEN=""
