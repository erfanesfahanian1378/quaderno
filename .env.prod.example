# Production environment. Copy to .env.prod on the server and fill in.
#
#   cp .env.prod.example .env.prod
#
# .env.prod is gitignored. It holds the database password, the object-store
# secret and AUTH_SECRET, and it should never leave the server.
#
# Generate every secret below rather than inventing one:
#   openssl rand -base64 32

# --- The name people type -----------------------------------------------------
# No scheme, no trailing slash. Caddy gets a Let's Encrypt certificate for
# exactly this name, so its DNS A record must already point at this server or
# the first request fails and Caddy backs off for a while.
DOMAIN="quaderno.example.com"

# Where Let's Encrypt sends expiry warnings. A real address you read.
ACME_EMAIL="you@example.com"

# --- Database -----------------------------------------------------------------
# Compose builds DATABASE_URL from these; do not set DATABASE_URL by hand here.
POSTGRES_USER="quaderno"
POSTGRES_PASSWORD=""
POSTGRES_DB="quaderno"

# --- Object storage -----------------------------------------------------------
# These are MinIO's root credentials AND the app's S3 keys — one pair, because
# MinIO is single-tenant here and a second set of keys would be two things to
# rotate instead of one.
S3_BUCKET="quaderno"
S3_ACCESS_KEY_ID="quaderno"
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"
# S3_ENDPOINT and S3_PUBLIC_ENDPOINT are set by compose. The public one has to
# be the address a BROWSER can reach, because presigned URLs are handed to the
# browser and SigV4 signs the host.

# --- Auth ---------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""

# Optional. See .env.example for how to get these; the redirect URI must be
# https://<DOMAIN>/api/auth/callback/google, exactly.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Reminders ----------------------------------------------------------------
# npx web-push generate-vapid-keys
# All three together or none: without them reminders are simply off.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Limits -------------------------------------------------------------------
MAX_UPLOAD_BYTES="157286400"          # 150 MB
DEFAULT_STORAGE_QUOTA_BYTES="2147483648"  # 2 GiB per person

# --- Translation --------------------------------------------------------------
# Blank means the free public services, which see the text being translated.
# For a local one: docker compose --profile translate up -d, then
# TRANSLATE_URL="http://libretranslate:5000". It wants about a gigabyte of RAM.
TRANSLATE_URL=""
LINGVA_URL="https://lingva.ml"

# --- Logging ------------------------------------------------------------------
LOG_LEVEL="info"
NODE_ENV="production"
